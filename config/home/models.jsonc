{
  "providers": {
    "opencode-go": {
      "apiKey": "$OPENCODE_GO_API_KEY",
    },
    "litellm": {
      "baseUrl": "https://litellm.inglehart.io/v1",
      "apiKey": "$LITELLM_PI_API_KEY",
      "api": "openai-completions",
      "compat": {
        "supportsStore": false,
      },
      "models": [
        {
          "id": "qwen3.8-27b-q4",
          "name": "Qwen3.8 27B Q4",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 196608,
        },
      ],
    },
    "gb10": {
      "baseUrl": "http://10.0.10.180:8888/v1",
      "apiKey": "$GB10_VLLM_API_KEY",
      "api": "openai-completions",
      "compat": {
        "supportsDeveloperRole": false,
        "supportsReasoningEffort": false,
        "supportsStore": false,
      },
      "models": [
        {
          "id": "GLM-5.3-Flash-EXL3",
          "name": "GLM-5.3 Flash EXL3 (GB10)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 500000,
        },
        {
          "id": "deepseek-v4-flash-vision-exp",
          "name": "DeepSeek V4 Flash (GB10)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
        },
        {
          "id": "MiMo-V2.6-Flash-RL",
          "name": "MiMo V2.6 Flash RL (GB10)",
          "reasoning": true,
          "input": ["text"],
          // Prompts above 64K are not tested with this runtime configuration.
          "contextWindow": 262144,
          "maxTokens": 16384,
          "compat": {
            "maxTokensField": "max_tokens",
            "thinkingFormat": "chat-template",
            "chatTemplateKwargs": {
              "enable_thinking": { "$var": "thinking.enabled" },
            },
          },
        },
      ],
    },
  },
}
