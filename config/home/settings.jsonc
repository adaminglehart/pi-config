{
  "honcho": {
    "baseUrl": "https://honcho.inglehart.io",
  },
  "defaultModel": "{{model.strong}}",
  "modelAliases": {
    "fast": "openai-codex/gpt-5.6-luna",
    "standard": "openai-codex/gpt-5.6-terra",
    "strong": "openai-codex/gpt-6-astra",
    "reviewer": "openai-codex/gpt-6-astra",
  },
  "defaultThinkingLevel": "medium",
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-luna",
    "litellm/qwen3.8-27b-q4",
    "openai-codex/gpt-5.3-codex-spark",
    "openrouter/deepseek/deepseek-v4-pro",
    "openrouter/deepseek/deepseek-v4-flash",
    "google/gemini-3.8-flash",
  ],
  "compaction": {
    "provider": "openrouter",
    "model": "google/gemini-3.8-flash",
  },
  "sessionTitle": {
    "provider": "openai-codex",
    "model": "gpt-5.6-luna",
  },
  // "lcm": {
  //   "summaryProvider": "openai-codex",
  //   "summaryModel": "GPT-4o",
  // },
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-terra",
    "agentOverrides": {
      "reviewer": {
        "model": "{{model.reviewer}}",
        "thinking": "high",
      },
      "scout": {
        "thinking": "medium",
      },
      "researcher": {
        "tools": ["read", "write", "websearch", "webfetch", "intercom"],
      },
    },
  },
}
