{
  "honcho": {
    "baseUrl": "https://honcho.inglehart.io",
  },
  "defaultModel": "{{model.standard}}",
  "defaultThinkingLevel": "{{model.standard.thinking}}",
  "modelAliases": {
    "fast": { "model": "openai-codex/gpt-6-luna", "thinking": "max" },
    "standard": { "model": "openai-codex/gpt-6-sol", "thinking": "medium" },
    "reviewer": { "model": "openai-codex/gpt-6-astra", "thinking": "high" },
  },
  "enabledModels": [
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6-luna",
    "litellm/qwen3.8-27b-q4",
    "opencode-go/deepseek-v4.1-flash",
    "google/gemini-3.8-flash",
    "gb10/deepseek-v4-flash-vision-exp",
    "gb10/GLM-5.3-Flash-EXL3"
  ],
  "compaction": {
    "provider": "openrouter",
    "model": "google/gemini-3.8-flash",
  },
  "sessionTitle": {
    "provider": "openai-codex",
    "model": "gpt-6-luna",
  },
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "agentOverrides": {
      "reviewer": {
        "model": "{{model.reviewer}}",
        "thinking": "{{model.reviewer.thinking}}",
      },
      "worker": {
        "model": "opencode-go/deepseek-v4.1-flash",
        "thinking": "high",
      },
      "scout": {
        "thinking": "medium",
      },
      "researcher": {
        "tools": ["read", "write", "websearch", "webfetch", "intercom"],
      },
    },
  },
}
