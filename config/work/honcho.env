# ==============================================================================
# LLM Provider Configuration - WORK (LiteLLM Proxy)
# ==============================================================================
# Route all LLM calls through LiteLLM proxy.

# --- Docker Compose extra_hosts ---
# Hostname the LLM proxy runs on, so docker-compose can map it to host-gateway
LITELLM_PROXY_HOST={{ env "LITELLM_PROXY_HOST" }}

# --- OpenAI-Compatible Proxy (LiteLLM) ---
# All work models use Honcho's OpenAI transport through the LiteLLM proxy.
LLM_OPENAI_API_KEY={{ env "LITELLM_API_KEY" }}

# --- Embeddings ---
# Keep the existing embedding model and 1536-dimensional vector space. Changing
# the embedding model requires re-embedding all stored messages and conclusions.
EMBEDDING_MODEL_CONFIG__TRANSPORT=openai
EMBEDDING_MODEL_CONFIG__MODEL=text-embedding-3-small
EMBEDDING_MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}

# --- Summary ---
# Summary is a high-volume, non-agentic task. Luna is the current cost- and
# latency-optimized GPT-5.6 model and supports native structured output.
SUMMARY_MODEL_CONFIG__TRANSPORT=openai
SUMMARY_MODEL_CONFIG__MODEL=gpt-5.6-luna
SUMMARY_MODEL_CONFIG__THINKING_EFFORT=none
SUMMARY_MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}

# --- Deriver ---
# The deriver writes durable memories and requires reliable structured output.
# Terra provides the current balance of extraction quality, latency, and cost.
DERIVER_MODEL_CONFIG__TRANSPORT=openai
DERIVER_MODEL_CONFIG__MODEL=gpt-5.6-terra
DERIVER_MODEL_CONFIG__THINKING_EFFORT=low
DERIVER_MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}

# --- Dialectic: minimal ---
# GPT-5.6 Chat Completions requires reasoning_effort=none when tools are present.
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__MODEL=gpt-5.6-luna
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__THINKING_EFFORT=none
DIALECTIC_LEVELS__minimal__MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}
DIALECTIC_LEVELS__minimal__MAX_TOOL_ITERATIONS=1

# --- Dialectic: low ---
DIALECTIC_LEVELS__low__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__low__MODEL_CONFIG__MODEL=gpt-5.6-terra
DIALECTIC_LEVELS__low__MODEL_CONFIG__THINKING_EFFORT=none
DIALECTIC_LEVELS__low__MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}
DIALECTIC_LEVELS__low__MAX_TOOL_ITERATIONS=2

# --- Dialectic: medium ---
# Claude 5 uses adaptive thinking. Provider parameters avoid LiteLLM's legacy
# fixed-thinking translation and send the current Bedrock request shape.
DIALECTIC_LEVELS__medium__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__medium__MODEL_CONFIG__MODEL=claude-sonnet-5
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}
DIALECTIC_LEVELS__medium__MODEL_CONFIG__OVERRIDES__PROVIDER_PARAMS={"extra_body":{"thinking":{"type":"adaptive"},"output_config":{"effort":"medium"}}}
DIALECTIC_LEVELS__medium__MAX_TOOL_ITERATIONS=2

# --- Dialectic: high ---
DIALECTIC_LEVELS__high__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__high__MODEL_CONFIG__MODEL=claude-sonnet-5
DIALECTIC_LEVELS__high__MODEL_CONFIG__MAX_OUTPUT_TOKENS=32768
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}
DIALECTIC_LEVELS__high__MODEL_CONFIG__OVERRIDES__PROVIDER_PARAMS={"extra_body":{"thinking":{"type":"adaptive"},"output_config":{"effort":"high"}}}
DIALECTIC_LEVELS__high__MAX_TOOL_ITERATIONS=5

# --- Dialectic: max ---
# The work proxy does not yet map Opus 5's newest "max" effort value, so use
# its verified xhigh mode for the deepest available agentic reasoning.
DIALECTIC_LEVELS__max__MODEL_CONFIG__TRANSPORT=openai
DIALECTIC_LEVELS__max__MODEL_CONFIG__MODEL=claude-opus-5
DIALECTIC_LEVELS__max__MODEL_CONFIG__MAX_OUTPUT_TOKENS=65536
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}
DIALECTIC_LEVELS__max__MODEL_CONFIG__OVERRIDES__PROVIDER_PARAMS={"extra_body":{"thinking":{"type":"adaptive"},"output_config":{"effort":"xhigh"}}}
DIALECTIC_LEVELS__max__MAX_TOOL_ITERATIONS=10

# --- Dream consolidation ---
# Dreams are infrequent, long-running memory synthesis tasks. Use Sonnet for
# deduction and Sol for induction; Sol was faster and produced better patterns.
DREAM_DEDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_DEDUCTION_MODEL_CONFIG__MODEL=claude-sonnet-5
DREAM_DEDUCTION_MODEL_CONFIG__MAX_OUTPUT_TOKENS=32768
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}
DREAM_DEDUCTION_MODEL_CONFIG__OVERRIDES__PROVIDER_PARAMS={"extra_body":{"thinking":{"type":"adaptive"},"output_config":{"effort":"high"}}}
DREAM_INDUCTION_MODEL_CONFIG__TRANSPORT=openai
DREAM_INDUCTION_MODEL_CONFIG__MODEL=gpt-5.6-sol
DREAM_INDUCTION_MODEL_CONFIG__MAX_OUTPUT_TOKENS=65536
DREAM_INDUCTION_MODEL_CONFIG__THINKING_EFFORT=none
DREAM_INDUCTION_MODEL_CONFIG__OVERRIDES__BASE_URL={{ env "LITELLM_BASE_URL" }}
