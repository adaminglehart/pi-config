{
  "honcho": {
    "baseUrl": "http://localhost:8100",
  },
  "defaultModel": "{{model.strong}}",
  "defaultThinkingLevel": "high",
  "modelAliases": {
    "fast": "litellm-openai/gpt-5.6-luna",
    "standard": "litellm-openai/gpt-5.6-terra",
    "strong": "litellm-openai/gpt-5.6-sol",
    "reviewer": "litellm-anthropic/claude-opus-5",
  },
  "enabledModels": [
    "litellm-openai/gpt-5.6-sol",
    "litellm-openai/gpt-5.6-terra",
    "litellm-openai/gpt-5.6-luna",
    "litellm-anthropic/claude-opus-5",
    "litellm-anthropic/claude-opus-4-8",
    "litellm-anthropic/claude-sonnet-5",
    "litellm-anthropic/claude-4.5-haiku",
    "litellm-google/gemini-3.1-pro",
    "litellm-google/gemini-3-flash",
  ],

  "compaction": {
    // "provider": "litellm-anthropic",
    // "model": "claude-sonnet-5",
    "provider": "litellm-openai",
    "model": "gpt-5.6-luna",
  },
  "sessionTitle": {
    "provider": "litellm-openai",
    "model": "gpt-5.6-luna",
  },
  // "lcm": {
  //   "summaryProvider": "litellm-google",
  //   "summaryModel": "gemini-3-flash",
  // },
  "subagents": {
    "agentOverrides": {
      "librarian": {
        "thinking": "xhigh",
        "model": "litellm-anthropic/claude-opus-5",
      },
      "researcher": {
        "thinking": "high",
        "model": "litellm-openai/gpt-5.6-sol",
      },
      "scout": {
        "thinking": "high",
        "model": "litellm-openai/gpt-5.6-luna",
      },
      "worker": {
        "thinking": "high",
        "model": "litellm-openai/gpt-5.6-sol",
      },
      "reviewer": {
        "thinking": "xhigh",
        "model": "litellm-anthropic/claude-opus-5",
      },
      "oracle": {
        "thinking": "max",
        "model": "litellm-anthropic/claude-opus-5",
      }
    },
  },
}
