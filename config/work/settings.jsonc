{
  "honcho": {
    "baseUrl": "http://localhost:8100",
  },
  "defaultModel": "litellm-anthropic/claude-opus-5-5",
  "defaultThinkingLevel": "medium",
  "modelAliases": {
    "fast": "litellm-openai/gpt-6-luna",
    "standard": "litellm-openai/gpt-6-sol",
    "reviewer": "litellm-anthropic/claude-opus-5-5",
  },
  "enabledModels": [
    "litellm-openai/gpt-6-astra",
    "litellm-openai/gpt-6-sol",
    "litellm-openai/gpt-6-luna",
    // "litellm-openai/gpt-5.6-sol",
    // "litellm-openai/gpt-5.6-luna",
    "litellm-anthropic/claude-opus-5-5",
    // "litellm-anthropic/claude-opus-5",
    // "litellm-anthropic/claude-sonnet-5",
    "litellm-google/gemini-3.1-pro",
    "litellm-google/gemini-3-flash",
  ],

  "compaction": {
    "provider": "litellm-openai",
    "model": "gpt-6-luna",
  },
  "sessionTitle": {
    "provider": "litellm-openai",
    "model": "gpt-6-luna",
  },
  "subagents": {
    "agentOverrides": {
      "librarian": {
        "thinking": "xhigh",
        "model": "litellm-anthropic/claude-opus-5",
      },
      "researcher": {
        "thinking": "high",
        "model": "litellm-openai/gpt-6-sol",
      },
      "scout": {
        "thinking": "high",
        "model": "litellm-openai/gpt-6-luna",
      },
      "worker": {
        "thinking": "high",
        "model": "litellm-openai/gpt-6-sol",
      },
      "reviewer": {
        "thinking": "high",
        "model": "{{model.reviewer}}",
      },
      "oracle": {
        "thinking": "max",
        "model": "litellm-anthropic/claude-opus-5",
      }
    },
  },
}
