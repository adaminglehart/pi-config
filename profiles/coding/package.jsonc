{
  "name": "@pi/profile-coding",
  "private": true,
  "pi": {
    "destDir": "~/.pi/agent",
    "extensions": [
      "animations",
      "answer",
      "cost",
      "custom-footer",
      "lossless-context",
      // "custom-compaction",
      "custom-startup-info",
      "herdr-agent-state",
      // "dev-browser",
      // "honcho",
      "hindsight",
      "lsp",
      "minimal-tools",
      "notify",
      "subagent",
      "todos",
      "tokens-per-second",
      "webfetch",
      "websearch",
    ],
    "skills": [
      "msgvault-api",
      "pi-extension",
      "session-reader",
      "agent-browser",
      "autoreview",
    ],
    "vars": {
      "work": {
        "model.fast": "litellm-google/gemini-3-flash",
        "model.standard": "litellm-anthropic/claude-sonnet-5",
        "model.strong": "litellm-openai/gpt-5.5",
        "model.reviewer": "litellm-openai/gpt-5.5",
      },
      "home": {
        "model.fast": "openai-codex/gpt-5.6-luna",
        "model.standard": "openai-codex/gpt-5.6-terra",
        "model.strong": "openai-codex/gpt-5.6-sol",
        "model.reviewer": "openai-codex/gpt-5.6-sol",
      },
    },
  },
}
