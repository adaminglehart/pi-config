{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "build.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "build",
    "extensions",
    "node_modules"
  ]
}
